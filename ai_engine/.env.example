# AI Engine Configuration

# FastAPI Service
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=True

# Django Service
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8001
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here

# Database (for AI engine - separate from HMS)
AI_DB_HOST=localhost
AI_DB_PORT=5432
AI_DB_NAME=hms_ai_db
AI_DB_USER=ai_user
AI_DB_PASSWORD=ai_password

# HMS Integration
HMS_API_URL=http://localhost/hms/backend/api
HMS_API_KEY=your-hms-api-key

# Model Configuration
MODEL_PATH=./models
MODEL_VERSION=1.0
RETRAIN_INTERVAL=30  # days

# Security
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090
